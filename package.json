{
  "name": "duelice",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "pnpm build && vite preview",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm test:balance",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:balance": "vitest run --config vitest.balance.config.ts",
    "test:e2e": "playwright test",
    "generate-routes": "tsr generate",
    "cf-typegen": "wrangler types",
    "test:mutation": "stryker run",
    "eval:pool": "node --import ./src/eval/register.mjs src/eval/pool.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "lucide-react": "1.48.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.149.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
